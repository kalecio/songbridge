{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "songbridge",
  "version": "0.6.0",
  "identifier": "com.songbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "songbridge",
        "minWidth": 900,
        "minHeight": 720,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Music",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: 76C3CAFED052E579\nRWR55VLQ/srDdj+uEDuVDlG9bG3ZHF4yyw7EHHOrEvZSUFSl4UNBPXOU",
      "endpoints": ["https://github.com/kalecio/songbridge/releases/latest/download/latest.json"]
    },
    "discord-rpc": {
      "applicationId": "1520795932818407514"
    }
  }
}
