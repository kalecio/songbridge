{
  "name": "songbridge",
  "private": true,
  "version": "0.6.0",
  "author": "Kal\u00e9cio Santana <kalecio.santana@gmail.com>",
  "description": "A desktop music player with library scanning, playlist management, and search",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "tauri": "tauri",
    "prepare": "husky",
    "website:build": "node scripts/build-website.mjs",
    "website:dev": "vite website --host 127.0.0.1",
    "website:deploy": "npm run website:build && wrangler pages deploy dist-website --project-name=songbridge-website --branch=main"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "lint-staged": "^16.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.1",
    "react-icons": "^5.5.0",
    "react-router": "^7.13.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.158.0"
  },
  "resolutions": {
    "styled-components": "^6"
  }
}
